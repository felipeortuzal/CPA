{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cpa-study-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna",
    "CHAT_ALLOWED_ORIGINS": "https://felipeortuzal.github.io,http://localhost:5173,http://localhost:4173,null"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  }
}
