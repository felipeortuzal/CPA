{
  "name": "cpa-study-platform",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:standalone",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:questions": "vitest run content/cpa/questions/questions.validation.test.ts",
    "validate": "npm run validate:curriculum && npm run validate:lessons && npm run validate:questions && npm run validate:sources && npm run validate:experience && npm run audit:v13 && npm run validate:v21 && npm test && npm run lint && npm run typecheck && npm run build",
    "validate:sources": "node scripts/validate-official-sources.mjs",
    "check:sources": "node scripts/check-official-sources.mjs",
    "validate:experience": "node scripts/validate-v12-experience.mjs",
    "audit:v13": "node scripts/audit-v13.mjs",
    "validate:lessons": "vitest run content/cpa/lessons/lessons.validation.test.ts",
    "validate:v21": "node scripts/validate-v21.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
